{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "isocore-broadcast",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-16",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/webhooks/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "isocore-broadcast-db", "database_id": "REPLACE_WITH_YOUR_D1_ID", "migrations_dir": "migrations" }]
}
